---
import Discography from "./Discography.astro";
import AlbumDetail from "./AlbumDetail.astro";
import ScrollReveal from "./ScrollReveal.astro";
import type { Band, Album } from "../types";
export interface Props {
  band: Band;
  albums: Album[];
}
const { band, albums } = Astro.props;
---
<ScrollReveal>
  <section id={band.id} class="py-20 px-4 md:px-8 max-w-5xl mx-auto" data-band-section>
    <div class="flex flex-col items-start gap-2">
      <img src={band.logoSvgNegro} alt={band.name} class="max-h-28 md:max-h-36 w-auto max-w-xs dark:hidden" />
      <img src={band.logoSvg} alt={band.name} class="max-h-28 md:max-h-36 w-auto max-w-xs hidden dark:block" />
      <p class="text-sm opacity-60 uppercase tracking-widest">{band.yearsActive}</p>
    </div>
    <p
      data-band-history
      tabindex="0"
      role="button"
      aria-expanded="false"
      class="mt-6 text-lg leading-relaxed collapsed"
    >
      <span data-lang="es">{band.history}</span>
      {band.historyEn && <span data-lang="en">{band.historyEn}</span>}
    </p>
    <div class="mt-10 band-content">
      <Discography albums={albums} />
      {albums.map((album) => (
        <AlbumDetail album={album} band={band} />
      ))}
    </div>
    <button
      type="button"
      data-back-to-top
      class="mt-12 block w-fit mx-auto border-2 border-current px-6 py-3 text-xs uppercase tracking-widest cursor-pointer transition-transform duration-200 hover:-translate-y-0.5"
    >
      <span aria-hidden="true">↑</span> <span data-i18n="band.backToTop">Volver arriba</span>
    </button>
  </section>
</ScrollReveal>
